# Seed config for Xiaomi Mi Router 3G (R3G), ramips/mt7621
# Verified against fanchmwrt-25.12.4 source:
#   target/linux/ramips/image/mt7621.mk -> "define Device/xiaomi_mi-router-3g"
#     SUPPORTED_DEVICES += R3G mir3g xiaomi,mir3g
#   This device's default DEVICE_PACKAGES already include kmod-usb3 and
#   kmod-usb-ledtrig-usbport, so USB3 host support ships out of the box.
#
# NOTE: if your router is hardware revision v2 (label says "R3G v2" /
# board is DSA-based), use CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g-v2
# instead - v2 does NOT enable USB packages by default.
#
# NOTE: fanchmwrt does not ship a "kmod-rtl8188eu" driver package by default
# (checked package/kernel/mac80211/realtek.mk and the packages/
# fanchmwrt-packages feeds - no such driver package exists there). The
# in-tree mac80211 driver kmod-rtl8xxxu claims to cover RTL8188EU, but
# confirmed by the user's own hardware test it FAILS on real RTL8188ETV
# dongles (0bda:0179) with "failed to parse EFuse" / probe error -22 - the
# mac80211 driver's EFuse parser is too strict for these cheap variant
# chips. The vendor-derived driver actually works (verified by the user,
# both on ImmortalWrt and confirmed working after flashing). That vendor
# driver isn't in fanchmwrt either, so it's vendored into this repo at
# packages/rtl8188eu/ (copied verbatim from immortalwrt/immortalwrt
# package/kernel/rtl8188eu, which builds it from
# https://github.com/aircrack-ng/rtl8188eus.git, pinned commit
# af3bf004458f76b7aec33e9ba552cd382ed1f5c3, dated 2025-02-04 - actively
# maintained, and ImmortalWrt itself currently builds it against kernel 6.18,
# newer than fanchmwrt's 6.12, so kernel-compat risk is low).
# The build.yml workflow copies packages/rtl8188eu/ into
# openwrt/package/kernel/rtl8188eu/ before running feeds update/make defconfig.
#
# CONFIG_PACKAGE_rtl8188eu-firmware IS a real, separate package - it lives in
# the base source tree at package/firmware/linux-firmware/realtek.mk (present
# in both fanchmwrt and immortalwrt, confirmed by grep), installing
# rtlwifi/rtl8188eufw.bin. It's independent of the kmod-rtl8188eu driver
# package above (different subsystem: linux-firmware collection vs a
# standalone kernel module), and the user's own ImmortalWrt build log shows
# it actually gets installed (rtl8188eu-firmware 20260221-r1), so keep it.
#
# RUNTIME NOTE (kernel 6.12): do NOT let netifd/LuCI manage this USB card in
# AP or STA mode - the vendor driver's set_config wedges and freezes the
# router. Drive it manually with wpa_supplicant instead (see README).

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y

CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-rtl8188eu=y
CONFIG_PACKAGE_rtl8188eu-firmware=y
# usbutils DEPENDS on +libudev, which is a virtual package; `make defconfig`
# won't auto-pick a provider, so usbutils would be silently dropped. Explicitly
# select the provider (libudev-zero, the lightweight libudev impl) so usbutils
# survives defconfig.
CONFIG_PACKAGE_libudev-zero=y
CONFIG_PACKAGE_usbutils=y
